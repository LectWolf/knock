#!/usr/bin/env bash
# knock —— 节点管理命令。不带参数就是菜单。
#
#   knock                菜单
#   knock status         服务状态、门、端口、中继
#   knock code           节点码
#   knock port 30990     改房间服务端口（中继配置会跟着改）
#   knock logs [-f]      日志
#   knock restart        重启
#   knock relay on|off   开关数据中转
#   knock uninstall      卸载
set -uo pipefail

DATA_DIR="${KNOCK_DATA_DIR:-/var/lib/knock}"
CFG="$DATA_DIR/node.json"
RELAY_TOML=/etc/knock-relay.toml
UNIT=knock-node
BIN=/usr/local/bin/knock-hub
C_ACC=$'\033[38;5;179m'; C_OK=$'\033[32m'; C_WARN=$'\033[33m'; C_MUT=$'\033[90m'; C_OFF=$'\033[0m'
ok()   { printf '%s✓%s %s\n' "$C_OK" "$C_OFF" "$*"; }
warn() { printf '%s！%s %s\n' "$C_WARN" "$C_OFF" "$*"; }
dim()  { printf '%s%s%s\n' "$C_MUT" "$*" "$C_OFF"; }

json_str() { sed -n 's/.*"'"$1"'": *"\([^"]*\)".*/\1/p' "$CFG" 2>/dev/null | head -1; }
json_num() { sed -n 's/.*"'"$1"'": *\([0-9]*\).*/\1/p' "$CFG" 2>/dev/null | head -1; }

# 中继的监控端口（Prometheus 文本）。没开监控就返回空。
metrics_addr() { sed -n 's/^metrics_bind_addr *= *"\([^"]*\)"/\1/p' "$RELAY_TOML" 2>/dev/null | head -1; }
metric() { # metric <指标名>：取不到返回空
  local addr
  addr="$(metrics_addr)"
  [[ -n "$addr" ]] || return 1
  curl -fsS --max-time 2 "http://$addr/metrics" 2>/dev/null | awk -v k="$1" '$1 == k { print $2; exit }'
}
human_bytes() {
  awk -v b="${1:-0}" 'BEGIN { split("B KB MB GB TB", u, " "); i = 1; while (b >= 1024 && i < 5) { b /= 1024; i++ } printf "%.1f %s", b, u[i] }'
}
# UDP 端口放行了吗（1Panel 默认整段 DROP，最容易踩这个坑）
# 规则可能是单端口、端口范围（30990:30991）或 multiport 列表，都得认。
udp_allowed() {
  local p="$1"
  iptables -S 2>/dev/null | awk -v p="$p" '
    /-j ACCEPT/ && /-p udp/ {
      if (match($0, /--dports[= ]+[0-9:,]+/)) {
        spec = substr($0, RSTART, RLENGTH); sub(/--dports[= ]+/, "", spec)
        n = split(spec, parts, ",")
        for (i = 1; i <= n; i++) {
          if (parts[i] ~ /:/) { split(parts[i], r, ":"); if (p + 0 >= r[1] + 0 && p + 0 <= r[2] + 0) hit = 1 }
          else if (parts[i] + 0 == p + 0) hit = 1
        }
      } else if (match($0, /--dport[= ]+[0-9]+(:[0-9]+)?/)) {
        spec = substr($0, RSTART, RLENGTH); sub(/--dport[= ]+/, "", spec)
        if (spec ~ /:/) { split(spec, r, ":"); if (p + 0 >= r[1] + 0 && p + 0 <= r[2] + 0) hit = 1 }
        else if (spec + 0 == p + 0) hit = 1
      }
    }
    END { exit(hit ? 0 : 1) }'
}
need_root() { [[ ${EUID:-0} -eq 0 ]] || { warn "这个操作要 root：sudo knock …"; exit 1; }; }

status() {
  local active name rooms port relay relay_port maxr crowd body mood
  active="$(systemctl is-active $UNIT 2>/dev/null || true)"
  name="$(json_str name)"; port="$(json_num public_port)"
  relay="$(json_str relay_url)"; relay_port="$(json_str relay_public_port)"
  maxr="$(json_num max_rooms)"; maxr="${maxr:-0}"
  body="$(curl -fsS --max-time 3 "http://127.0.0.1:${port}/healthz" 2>/dev/null || true)"
  rooms="$(printf '%s' "$body" | sed -n 's/.*"rooms":\([0-9]*\).*/\1/p')"

  printf '  服务    %s%s%s\n' "$C_OK" "${active:-未知}" "$C_OFF"
  printf '  节点    %s\n' "${name:-未命名}"

  # —— 门 ——
  if [[ -n "$rooms" ]]; then
    if [[ "$maxr" -gt 0 ]]; then
      crowd="$(( rooms * 100 / maxr ))"
      mood="宽松"
      (( crowd >= 80 )) && mood="很挤"
      (( crowd >= 50 && crowd < 80 )) && mood="有点挤"
      printf '  门      %s 扇开着 · 上限 %s（%s%%，%s）\n' "$rooms" "$maxr" "$crowd" "$mood"
    else
      printf '  门      %s 扇开着 · 不限数量\n' "$rooms"
    fi
  else
    printf '  门      %s\n' "读不到（服务没起？）"
  fi

  # —— 端口：谁干什么，写清楚 ——
  printf '\n  端口\n'
  printf '    门/信令   TCP %s     登记房间、健康检查\n' "$port"
  if [[ -n "$relay" ]]; then
    local rp="${relay_port:-$port}"
    printf '    中继      TCP %s     TLS，打不开洞时数据走这里\n' "$rp"
    printf '    打洞辅助  UDP %s     QUIC 地址发现，帮两边互相找到\n' "$rp"
  else
    printf '    中继      %s\n' "未开启（只做信令）"
  fi

  # —— 中继 / 打洞 的实际状态 ——
  if [[ -n "$relay" ]]; then
    if systemctl is-active knock-relay >/dev/null 2>&1; then
      printf '\n  中继    %s开%s\n' "$C_OK" "$C_OFF"
    else
      printf '\n  中继    %s！进程没起（systemctl status knock-relay）%s\n' "$C_WARN" "$C_OFF"
    fi
    local lim
    lim="$(relay_limit)"
    if [[ -n "$lim" && "$lim" -gt 0 ]]; then
      printf '  每路限速  %s/s（每条中继连接，直连不受影响）\n' "$(human_bytes "$lim")"
    fi
    local qad
    qad="$(sed -n 's/^enable_quic_addr_discovery *= *\(true\|false\).*/\1/p' "$RELAY_TOML" 2>/dev/null | head -1)"
    if [[ "$qad" == "true" ]]; then
      if udp_allowed "${relay_port:-$port}"; then
        printf '  打洞    %s开%s（UDP %s 已放行）\n' "$C_OK" "$C_OFF" "${relay_port:-$port}"
      else
        printf '  打洞    %s！UDP %s 没放行，客户端会一直绕路%s\n' "$C_WARN" "${relay_port:-$port}" "$C_OFF"
      fi
    else
      printf '  打洞    %s关%s\n' "$C_MUT" "$C_OFF"
    fi
  fi

  # —— 流量 ——
  local sent recv accepts disconns
  sent="$(metric relayserver_bytes_sent_total)"
  recv="$(metric relayserver_bytes_recv_total)"
  if [[ -n "$sent" || -n "$recv" ]]; then
    accepts="$(metric relayserver_accepts_total)"
    disconns="$(metric relayserver_disconnects_total)"
    printf '\n  流量（中继自启动以来）\n'
    printf '    发出 %s · 收到 %s\n' "$(human_bytes "${sent:-0}")" "$(human_bytes "${recv:-0}")"
    if [[ -n "$accepts" && -n "$disconns" ]]; then
      printf '    当前连接 %s · 累计 %s 次\n' "$(( accepts - disconns ))" "$accepts"
    fi
  elif [[ -n "$relay" ]]; then
    printf '\n  %s流量读不到：中继监控没开（enable_metrics = true）%s\n' "$C_MUT" "$C_OFF"
  fi

  # —— 证书 ——
  local cert days
  cert="$(sed -n 's/^manual_cert_path *= *"\([^"]*\)"/\1/p' "$RELAY_TOML" 2>/dev/null | head -1)"
  if [[ -n "$cert" && -f "$cert" ]]; then
    days="$(openssl x509 -in "$cert" -noout -enddate 2>/dev/null | sed 's/notAfter=//' | xargs -I{} date -d {} +%s 2>/dev/null | awk -v now="$(date +%s)" '{ printf "%d", ($1 - now) / 86400 }')"
    printf '\n  证书    %s 天后到期\n' "${days:-?}"
  fi
}

code() {
  local raw node_code
  raw="$($BIN -config "$CFG" -data-dir "$DATA_DIR" -print-code 2>/dev/null || true)"
  node_code="$(printf '%s' "$raw" | grep -oE '[0-9A-HJKMNP-TV-Z]{20,}' | head -1)"
  if [[ -z "$node_code" ]]; then warn "没拿到节点码：journalctl -u $UNIT | grep 节点码"; return; fi
  printf '\n  %s%s%s\n\n' "$C_ACC" "$node_code" "$C_OFF"
}

# 改端口：房间服务端口、中继端口、以及两者同端口时的 relay_url 一起改
set_port() {
  need_root
  local want="${1:-}" old new
  [[ "$want" =~ ^[0-9]+$ ]] && (( want > 0 && want < 65536 )) || { warn "用法：knock port <1-65535>"; return 1; }
  [[ -f "$CFG" ]] || { warn "找不到 $CFG"; return 1; }
  old="$(json_num public_port)"
  new="$want"
  [[ "$old" == "$new" ]] && { ok "端口本来就是 $new"; return 0; }
  local relay relay_port
  relay="$(json_str relay_url)"; relay_port="$(json_str relay_public_port)"
  sed -i "s/\"public_port\": *[0-9]*/\"public_port\": $new/; s/\"listen\": *\"[^\"]*\"/\"listen\": \":$new\"/" "$CFG"
  # 同端口模式（中继共用）：relay_url 里的端口也要跟着走
  if [[ -n "$relay" && ( -z "$relay_port" || "$relay_port" == "$old" ) ]]; then
    sed -i "s|\"relay_url\": *\"[^\"]*\"|\"relay_url\": \"${relay%:*}:$new\"|; s/\"relay_public_port\": *\"[^\"]*\"/\"relay_public_port\": \"$new\"/" "$CFG"
  fi
  systemctl restart $UNIT; sleep 1
  if systemctl is-active --quiet $UNIT; then
    ok "端口 $old → $new"
    warn "别忘了在云厂商安全组放行 TCP $new（旧端口可以关掉）"
  else
    warn "没起来：journalctl -u $UNIT -n 30"
    sed -i "s/\"public_port\": *[0-9]*/\"public_port\": $old/; s/\"listen\": *\"[^\"]*\"/\"listen\": \":$old\"/" "$CFG"
    systemctl restart $UNIT
    warn "已回滚到 $old"
  fi
}

relay_toggle() {
  need_root
  [[ -f "$CFG" ]] || { warn "找不到 $CFG"; return 1; }
  local want="${1:-}" port relay_port addr public
  port="$(json_num public_port)"; addr="$(json_str ipv4)"
  case "$want" in
    on)
      relay_port="$(json_str relay_public_port)"
      if [[ -n "$relay_port" && "$relay_port" != "$port" ]]; then
        # 拆分模式：中继有自己的端口
        sed -i "s|\"relay_url\": *\"[^\"]*\"|\"relay_url\": \"${SCHEME:-http}://$addr:$relay_port\"|; s|\"relay_local\": *\"[^\"]*\"|\"relay_local\": \"\"|; s|\"relay_allowed\": *false|\"relay_allowed\": true|" "$CFG"
        ok "中继已开启（单独 $relay_port 端口）"
      else
        sed -i "s|\"relay_url\": *\"[^\"]*\"|\"relay_url\": \"http://$addr:$port\"|; s|\"relay_local\": *\"[^\"]*\"|\"relay_local\": \"127.0.0.1:30991\"|; s|\"relay_allowed\": *false|\"relay_allowed\": true|; s|\"allow_plain_relay\": *false|\"allow_plain_relay\": true|" "$CFG"
        ok "中继已开启（与房间服务共用 $port 端口）"
      fi
      systemctl enable --now knock-relay >/dev/null 2>&1 || warn "knock-relay 没起来（iroh-relay 装了吗？）"
      ;;
    off)
      sed -i 's|"relay_url": *"[^"]*"|"relay_url": ""|; s|"relay_local": *"[^"]*"|"relay_local": ""|; s|"relay_allowed": *true|"relay_allowed": false|' "$CFG"
      systemctl disable --now knock-relay >/dev/null 2>&1 || true
      ok "中继已关闭（只做信令）" ;;
    *) warn "用法：knock relay on|off"; return 1;;
  esac
  systemctl restart $UNIT; sleep 1
  systemctl is-active --quiet $UNIT && ok "服务已重启" || warn "服务没起来：journalctl -u $UNIT -n 30"
}

# 证书：看还剩多少天；--check 给定时器用（快到期返回 1，让 journal 留一条）
cert() {
  local path="${KNOCK_CERT_PATH:-}" check="${1:-}" end days mode
  if [[ -z "$path" ]]; then
    path="$(sed -n 's/.*manual_cert_path *= *"\([^"]*\)".*/\1/p' "$RELAY_TOML" 2>/dev/null | head -1)"
  fi
  if [[ -z "$path" || ! -f "$path" ]]; then
    warn "没找到证书：${path:-（配置里没有）}"
    [[ -n "$check" ]] && return 1
    return 0
  fi
  end="$(openssl x509 -enddate -noout -in "$path" 2>/dev/null | cut -d= -f2)"
  if [[ -z "$end" ]]; then
    warn "读不出到期时间：$path（是 PEM 证书吗）"
    [[ -n "$check" ]] && return 1
    return 0
  fi
  days="$(( ( $(date -d "$end" +%s) - $(date +%s) ) / 86400 ))"
  mode="$(sed -n 's/.*cert_mode *= *"\([^"]*\)".*/\1/p' "$RELAY_TOML" 2>/dev/null | head -1)"
  if [[ -n "$check" ]]; then
    if (( days < 30 )); then
      warn "证书还有 $days 天到期（$end）：$path —— 该续了"
      return 1
    fi
    dim "证书还有 $days 天到期，正常"
    return 0
  fi
  printf '  证书    %s\n' "$path"
  printf '  到期    %s（还有 %s 天）\n' "$end" "$days"
  if [[ "$mode" == "Reloading" ]]; then
    printf '  模式    Reloading · 换掉文件就自动生效，不用重启\n'
  else
    printf '  模式    %s\n' "${mode:-未知}"
  fi
}

uninstall() {
  need_root
  local keep
  read -r -p "要保留配置和数据（$DATA_DIR）吗？[Y/n] " keep
  systemctl disable --now $UNIT >/dev/null 2>&1 || true
  systemctl disable --now knock-relay >/dev/null 2>&1 || true
  rm -f /etc/systemd/system/knock-node.service /etc/systemd/system/knock-relay.service
  systemctl daemon-reload
  rm -f /usr/local/bin/knock-hub /usr/local/bin/knock /usr/local/bin/iroh-relay
  if [[ "${keep:-Y}" =~ ^[Yy] ]]; then ok "二进制已删，$DATA_DIR 保留"; else rm -rf "$DATA_DIR"; ok "全清了"; fi
}

# ————————————————————————————————————————————————
# 界面：整屏刷新，不是日志滚动
#
# 每个操作都是「画一屏 → 等你操作 → 按 q 回菜单」，
# 而不是把输出一行行堆上去。这样你看的是"现在是什么状态"，不是"刚才发生了什么"。
# ————————————————————————————————————————————————
W=52
hr() { printf '%s\n' "$(printf '─%.0s' $(seq 1 $W))"; }

screen() { # screen <标题>
  clear
  printf '%s\n' "$C_MUT$1$C_OFF"
  hr
}

back_hint() {
  printf '\n%s按 q 返回菜单%s ' "$C_MUT" "$C_OFF"
  local k
  read -rsn1 k || true
  [[ "$k" == "q" || "$k" == "Q" ]] || true
}

confirm() { # confirm <问题> -> 0/1
  printf '%s\n' "$1"
  printf '%s[y/N]%s ' "$C_ACC" "$C_OFF"
  local a
  read -r a || true
  [[ "${a:-n}" =~ ^[Yy] ]]
}

draw_menu() {
  local active name port relay_rp
  active="$(systemctl is-active $UNIT 2>/dev/null || true)"
  name="$(json_str name)"
  port="$(json_num public_port)"
  relay_rp="$(json_str relay_public_port)"
  clear
  printf '%s  Knock 节点管理%s\n' "$C_ACC" "$C_OFF"
  hr
  printf '  %-10s %s\n' "节点" "${name:-未命名}"
  printf '  %-10s %s%s%s\n' "服务" "$C_OK" "$active" "$C_OFF"
  printf '  %-10s 房间 %s%s\n' "端口" "$port" "$([[ -n "$relay_rp" ]] && echo " · 中继 $relay_rp")"
  printf '  %-10s %s\n' "中继" "$([[ -n "$(json_str relay_url)" ]] && echo "开" || echo "关（只做信令）")"
  hr
  printf '   1) 状态        2) 节点码      3) 日志\n'
  printf '   4) 重启        5) 开关中继    6) 改端口\n'
  printf '   7) 证书        8) 限流        9) 升级\n'
  printf '   u) 卸载\n'
  printf '   0) 退出\n'
  hr
  printf '选一个：'
}

view_status() {
  screen "状态"
  status | sed 's/^/  /'
  back_hint
}

view_code() {
  local raw code
  screen "节点码"
  raw="$($BIN -config "$CFG" -data-dir "$DATA_DIR" -print-code 2>/dev/null || true)"
  code="$(printf '%s' "$raw" | grep -oE '[0-9A-HJKMNP-TV-Z]{20,}' | head -1)"
  if [[ -n "$code" ]]; then
    printf '\n  %s%s%s\n\n' "$C_ACC" "$code" "$C_OFF"
    printf '  %s整串发给朋友，他粘进客户端就能敲%s\n' "$C_MUT" "$C_OFF"
  else
    warn "没拿到节点码（journalctl -u $UNIT | grep 节点码）"
  fi
  back_hint
}

view_logs() {
  screen "日志（最近 15 条）"
  journalctl -u $UNIT -n 15 --no-pager -o cat 2>/dev/null | sed 's/^/  /'
  back_hint
}

act_restart() {
  screen "重启"
  if confirm "确定重启节点服务？已经连着的房客会断。"; then
    systemctl restart $UNIT
    sleep 1
    systemctl is-active --quiet $UNIT && ok "重启完成" || warn "没起来，看 3) 日志"
  else
    dim "取消"
  fi
  back_hint
}

act_relay() {
  local on
  screen "开关中继"
  if [[ -n "$(json_str relay_url)" ]]; then
    printf '  现在：%s开%s（%s）\n\n' "$C_OK" "$C_OFF" "$(json_str relay_url)"
    if confirm "要关掉中继吗？关掉后直连打不通的人就进不来了。"; then relay_toggle off; else dim "取消"; fi
  else
    printf '  现在：%s关%s（只做信令）\n\n' "$C_MUT" "$C_OFF"
    if confirm "要打开中继吗？需要这台机装了 iroh-relay。"; then relay_toggle on; else dim "取消"; fi
  fi
  back_hint
}

act_port() {
  local old new
  screen "改端口"
  old="$(json_num public_port)"
  printf '  现在：房间服务监听 %s\n\n' "$old"
  printf '  新端口（直接回车取消）：'
  read -r new || true
  if [[ -z "${new:-}" ]]; then dim "取消"; back_hint; return; fi
  if ! [[ "$new" =~ ^[0-9]+$ ]] || (( new < 1 || new > 65535 )); then
    warn "端口要在 1-65535 之间"; back_hint; return
  fi
  printf '\n  改成 %s 后：\n' "$new"
  printf '    · 云厂商安全组要放行 TCP %s\n' "$new"
  printf '    · 旧端口可以关掉\n'
  if confirm "确定改吗？"; then set_port "$new"; else dim "取消"; fi
  back_hint
}

act_cert() {
  local mode cert key new
  screen "证书"
  mode="$(sed -n 's/.*cert_mode *= *"\([^"]*\)".*/\1/p' "$RELAY_TOML" 2>/dev/null | head -1)"
  cert="$(sed -n 's/.*manual_cert_path *= *"\([^"]*\)".*/\1/p' "$RELAY_TOML" 2>/dev/null | head -1)"
  key="$(sed -n 's/.*manual_key_path *= *"\([^"]*\)".*/\1/p' "$RELAY_TOML" 2>/dev/null | head -1)"
  printf '  模式    %s\n' "${mode:-未配置 TLS}"
  printf '  证书    %s\n' "${cert:-—}"
  printf '  私钥    %s\n' "${key:-—}"
  if [[ -n "$cert" && -f "$cert" ]]; then
    local end days
    end="$(openssl x509 -enddate -noout -in "$cert" 2>/dev/null | cut -d= -f2)"
    local end_ts now_ts
    end_ts="$(date -d "$end" +%s 2>/dev/null || echo 0)"
    now_ts="$(date +%s)"
    days=$(( (end_ts - now_ts) / 86400 ))
    printf '  到期    %s（还有 %s 天）\n' "$end" "$days"
    (( days < 30 )) && printf '  %s！该续了%s\n' "$C_WARN" "$C_OFF"
  fi
  hr
  printf '  c) 改证书路径    r) 重新加载    q) 返回\n'
  printf '选一个：'
  read -rsn1 new || true
  case "$new" in
    c)
      printf '\n\n  新的证书路径：'
      read -r new || true
      [[ -f "${new:-}" ]] || { warn "文件不存在"; back_hint; return; }
      local newkey
      printf '  新的私钥路径（回车 = 不变）：'
      read -r newkey || true
      [[ -n "${newkey:-}" ]] || newkey="$key"
      [[ -f "$newkey" ]] || { warn "私钥文件不存在"; back_hint; return; }
      sed -i "s|manual_cert_path *= *\"[^\"]*\"|manual_cert_path = \"$new\"|; s|manual_key_path *= *\"[^\"]*\"|manual_key_path = \"$newkey\"|" "$RELAY_TOML"
      # Reloading 模式下换文件即生效；仍旧重启一次更稳
      systemctl restart knock-relay >/dev/null 2>&1 || true
      ok "已更新，中继重启过";;
    r)
      systemctl restart knock-relay >/dev/null 2>&1 || true
      ok "中继已重新加载";;
    *) dim "返回";;
  esac
  back_hint
}


# 改一条限制：写回 node.json 再重启（配置只在启动时读）
# 中继对**每个客户端连接**的接收限速（字节/秒）。空 = 不限。
relay_limit() { sed -n 's/^bytes_per_second *= *\([0-9]*\)/\1/p' "$RELAY_TOML" 2>/dev/null | head -1; }

set_relay_limit() { # set_relay_limit <字节/秒>，0 = 去掉限速
  local bps="$1" tmp
  tmp="$(mktemp)"
  cp "$RELAY_TOML" "$RELAY_TOML.bak"
  # 先把旧的 [limits.client.rx] 整块摘掉（直到下一个 [ 开头的行）
  awk '
    /^\[limits\.client\.rx\]/ { skip = 1; next }
    skip && /^\[/ { skip = 0 }
    !skip { print }
  ' "$RELAY_TOML" > "$tmp"
  if [[ "$bps" -gt 0 ]]; then
    printf '\n[limits.client.rx]\nbytes_per_second = %s\nmax_burst_bytes = %s\n' "$bps" "$bps" >> "$tmp"
  fi
  cat "$tmp" > "$RELAY_TOML"
  rm -f "$tmp"
  systemctl restart knock-relay >/dev/null 2>&1
  sleep 1
  if systemctl is-active knock-relay >/dev/null 2>&1; then
    if [[ "$bps" -gt 0 ]]; then ok "每路限速 $(human_bytes "$bps")/s"; else ok "已取消限速"; fi
  else
    warn "中继没起来，已恢复原配置"
    cp "$RELAY_TOML.bak" "$RELAY_TOML"
    systemctl restart knock-relay >/dev/null 2>&1 || true
  fi
}

set_limit() { # set_limit <键> <值>
  local key="$1" val="$2"
  case "$key" in
    max_rooms|create_per_minute|lookup_per_minute)
      sed -i "s/\"$key\": *[0-9]*/\"$key\": $val/" "$CFG" || return 1
      ;;
    room_ttl)
      sed -i "s/\"room_ttl\": *\"[^\"]*\"/\"room_ttl\": \"$val\"/" "$CFG" || return 1
      ;;
  esac
  systemctl restart $UNIT >/dev/null 2>&1
  sleep 1
  if systemctl is-active $UNIT >/dev/null 2>&1; then
    ok "改好了，服务已重启"
  else
    warn "服务没起来，看 journalctl -u $UNIT -n 20"
  fi
}

view_limits() {
  local key label cur choice val bps kb
  while true; do
    screen "限流与容量"
    printf '  门与房间\n'
    printf '    1) 同时最多门数   %s%s%s   （0 = 不限）\n' "$C_ACC" "$(json_num max_rooms)" "$C_OFF"
    printf '    2) 每分钟开门数   %s%s%s\n' "$C_ACC" "$(json_num create_per_minute)" "$C_OFF"
    printf '    3) 每分钟查码数   %s%s%s\n' "$C_ACC" "$(json_num lookup_per_minute)" "$C_OFF"
    printf '    4) 房间寿命       %s%s%s\n' "$C_ACC" "$(json_str room_ttl)" "$C_OFF"
    printf '  中继\n'
    local lim
    lim="$(relay_limit)"
    if [[ -n "$lim" && "$lim" -gt 0 ]]; then
      printf '    5) 每路限速       %s%s/s%s   （每条连接，直连不受影响）\n' "$C_ACC" "$(human_bytes "$lim")" "$C_OFF"
    else
      printf '    5) 每路限速       %s不限%s\n' "$C_ACC" "$C_OFF"
    fi
    hr
    printf '  %s中继是按"每条连接"限速的：一个来客算一路。\n' "$C_MUT"
    printf '  直连（打洞成功）不经过中继，这边限不到。%s\n' "$C_MUT"
    printf '\n  选一个改（q 返回）：'
    read -rsn1 choice || true
    case "$choice" in
      1) key=max_rooms; label="最多同时几扇门（0 = 不限）";;
      2) key=create_per_minute; label="每分钟最多开几扇门";;
      3) key=lookup_per_minute; label="每分钟最多查几次码";;
      4) key=room_ttl; label="房间寿命（如 10m、1h）";;
      5)
        lim="$(relay_limit)"
        printf '\n\n  每路限速（KB/s，0 = 不限）\n  现在：%s\n  新值：' "$( [[ -n "$lim" && "$lim" -gt 0 ]] && echo "$(( lim / 1024 )) KB/s" || echo "不限" )"
        read -r kb || true
        [[ "$kb" =~ ^[0-9]+$ ]] || { warn "只能填数字"; back_hint; continue; }
        if [[ "$kb" -gt 1048576 ]]; then warn "最多 1048576 KB/s"; back_hint; continue; fi
        bps=$(( kb * 1024 ))
        set_relay_limit "$bps"
        back_hint
        continue;;
      q|Q) return;;
      *) continue;;
    esac
    if [[ "$key" == "room_ttl" ]]; then cur="$(json_str room_ttl)"; else cur="$(json_num "$key")"; fi
    printf '\n\n  %s\n  现在：%s\n  新值：' "$label" "$cur"
    read -r val || true
    if [[ "$key" == "room_ttl" ]]; then
      [[ "$val" =~ ^[0-9]+[smh]$ ]] || { warn "格式像 10m / 1h"; back_hint; continue; }
    else
      [[ "$val" =~ ^[0-9]+$ ]] || { warn "只能填数字"; back_hint; continue; }
      [[ "$key" == "max_rooms" ]] && { [[ "$val" -le 10000 ]] || { warn "最多 10000"; back_hint; continue; }; }
    fi
    set_limit "$key" "$val"
    back_hint
  done
}

act_upgrade() {
  screen "升级"
  printf '  升级要换二进制：带新的 install.sh 重跑，或者\n\n'
  printf '    curl -fsSL <新地址>/knock-hub-linux -o /usr/local/bin/knock-hub.new\n'
  printf '    install -m755 /usr/local/bin/knock-hub.new /usr/local/bin/knock-hub\n'
  printf '    systemctl restart knock-node\n\n'
  printf '  %s实例里不联网拉，避免升级到一半断网。%s\n' "$C_MUT" "$C_OFF"
  back_hint
}

act_uninstall() {
  screen "卸载"
  if confirm "真的卸载？会停服务、删二进制。"; then
    uninstall
  else
    dim "取消"
  fi
  back_hint
}

menu() {
  local choice
  while true; do
    draw_menu
    read -rsn1 choice || choice=0
    case "$choice" in
      1) view_status;;
      2) view_code;;
      3) view_logs;;
      4) act_restart;;
      5) act_relay;;
      6) act_port;;
      7) act_cert;;
      8) view_limits;;
      9) act_upgrade;;
      u|U) act_uninstall;;
      0|q|Q) clear; break;;
      *) ;;
    esac
  done
}


limits_cmd() {
  case "${1:-}" in
    "")
      printf '  最多门数      %s\n' "$(json_num max_rooms)"
      printf '  每分钟开门    %s\n' "$(json_num create_per_minute)"
      printf '  每分钟查码    %s\n' "$(json_num lookup_per_minute)"
      printf '  房间寿命      %s\n' "$(json_str room_ttl)"
      printf '  每路限速      %s\n' "$( if [[ -n "$(relay_limit)" && "$(relay_limit)" -gt 0 ]]; then echo "$(( $(relay_limit) / 1024 )) KB/s"; else echo 不限; fi )"
      ;;
    max-rooms)  need_root && set_limit max_rooms "${2:?用法: knock limits max-rooms 200}";;
    create)     need_root && set_limit create_per_minute "${2:?用法: knock limits create 10}";;
    lookup)     need_root && set_limit lookup_per_minute "${2:?用法: knock limits lookup 30}";;
    ttl)        need_root && set_limit room_ttl "${2:?用法: knock limits ttl 10m}";;
    rate)       need_root && set_relay_limit $(( ${2:?用法: knock limits rate 1024} * 1024 ));;
    *) warn "用法：knock limits [max-rooms N | create N | lookup N | ttl 10m | rate KB/s]"; return 1;;
  esac
}

case "${1:-menu}" in
  status) status;;
  code) code;;
  port) set_port "${2:-}";;
  cert) shift; cert "${1:-}";;
  logs) shift; journalctl -u $UNIT -n 80 --no-pager "$@";;
  restart) need_root && systemctl restart $UNIT && ok "重启了";;
  relay) relay_toggle "${2:-}";;
  limits) shift; limits_cmd "$@";;
  uninstall) uninstall;;
  menu) menu;;
  -h|--help) sed -n '2,12p' "$0" | sed 's/^# \{0,1\}//';;
  *) warn "不认识的命令：$1"; exit 2;;
esac
